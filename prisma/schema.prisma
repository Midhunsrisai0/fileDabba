// ------------------------------------------
//  Datasource & Generator
// ------------------------------------------
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}
// ------------------------------------------
//  User (for BetterAuth)
// ------------------------------------------
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folders   Folder[]
  files     File[]
}

// ------------------------------------------
//  Folder Tree Structure
// ------------------------------------------
model Folder {
  id        Int       @id @default(autoincrement())
  name      String
  parentId  Int?
  userId    Int?
  // Self-referential relation (Tree)
  parent    Folder?   @relation("FolderToSubfolders", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderToSubfolders")

  // User who owns this folder
  user      User?     @relation(fields: [userId], references: [id])

  // Files inside this folder
  files     File[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ------------------------------------------
//  Files
// ------------------------------------------
model File {
  id           Int       @id @default(autoincrement())
  originalName String
  internalName String     // UUID + extension
  extension    String
  mimeType     String
  size         Int
  folderId     Int
  userId       Int?

  folder       Folder    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
